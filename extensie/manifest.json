{
  "manifest_version": 3,
  "name": "Geluid Booster",
  "version": "1.0.0",
  "description": "Maak het geluid van een Chrome-tabblad harder dan 100% (tot 600%).",
  "permissions": ["tabCapture", "offscreen", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Geluid Booster",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
